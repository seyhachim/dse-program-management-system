{
  "name": "dse-pms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.2.23",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run db:generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "bun test",
    "test:backend": "bun test apps/backend",
    "test:backend:integration": "bun test apps/backend/src/integration/auth-authorization.integration.test.ts && bun test apps/backend/src/integration/lecturer-portfolio.integration.test.ts",
    "typecheck": "turbo run typecheck",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "db:migrate:deploy": "bun run --cwd apps/backend db:migrate:deploy",
    "db:generate": "bun run --cwd apps/backend db:generate",
    "seed": "bun run --cwd apps/backend seed",
    "gen-token": "bun run --cwd apps/backend gen-token"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  }
}
