# Copy to apps/frontend/.env.local and fill in.

NEXT_PUBLIC_API_URL=http://localhost:4000

# NEXT_PUBLIC_AUTH_MODE is required and never defaults.
# Use `dev` only for local development/tests.
# Production builds must use `supabase` and fail if a dev token is configured.
NEXT_PUBLIC_AUTH_MODE=dev

# local/test dev mode only: paste a token from `bun run gen-token --role admin`.
# Never configure NEXT_PUBLIC_DEV_TOKEN in Vercel Production/Preview environments.
NEXT_PUBLIC_DEV_TOKEN=

# supabase mode: project URL + public anon key (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
