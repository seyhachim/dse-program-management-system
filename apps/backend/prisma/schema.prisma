generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  Active
  Inactive
  Pending
}

enum StudentCohortStatus {
  Planned
  Active
  Completed
  Archived
}

enum StudentCohortMembershipExitReason {
  Withdrawn
  Transferred
  Graduated
  Other
}

enum StudentProgressionStatus {
  Progressed
  Retained
  Withdrawn
  Inactive
  Graduated
  Transferred
}

enum StudentCompletionOutcomeType {
  ProgrammeCompleted
  GraduationAwarded
}

enum ProgrammeOutcomeIndicatorType {
  ProgressionRate
  RetentionRate
  CompletionRate
  DropoutRate
  CloAttainmentRate
  PloAttainmentRate
}

enum OfferingStatus {
  Planned
  Active
  Completed
}

enum ClassResponsibilityRole {
  ClassMonitor
  SubClassMonitor
}

enum ClassResponsibilityAuditAction {
  Assigned
  Revoked
  Reassigned
}

enum Semester {
  First
  Second
}

enum CourseType {
  Basic
  Core
  Elective
  Specialization
  MoeysHeip
}

enum RubricStatus {
  Active
  Draft
  Archived
}

enum CourseSpecSectionStatus {
  Draft
  Complete
}

enum CourseSpecReviewStatus {
  Draft
  Submitted
  UnderReview
  ChangesRequested
  Resubmitted
  Approved
}

enum CourseSpecReviewActionType {
  Submitted
  Resubmitted
  ChangesRequested
  Approved
}

enum CourseSpecRevisionType {
  Initial
  Minor
  Major
}

enum CourseSpecRevisionTrigger {
  ScheduledReview
  StudentFeedback
  AlumniFeedback
  EmployerFeedback
  LecturerReflection
  ProgrammeCoordinator
  ExternalExaminer
  QaFinding
  RegulatoryChange
  Other
}

enum ProgrammeCurriculumStatus {
  Draft
  Approved
  Active
  Superseded
}

enum ProgrammeCurriculumRevisionType {
  Initial
  Minor
  Major
}

enum ProgrammeCurriculumRevisionTrigger {
  ScheduledReview
  StudentFeedback
  AlumniFeedback
  EmployerFeedback
  LecturerReflection
  ProgrammeCoordinator
  ExternalExaminer
  QaFinding
  RegulatoryChange
  Other
}

enum ProgrammeCurriculumAuditActionType {
  Created
  MetadataUpdated
  CourseAdded
  CourseUpdated
  CourseRemoved
  Approved
  Activated
  Superseded
}

enum ProgrammeGradingScaleVersionStatus {
  Draft
  Approved
  Superseded
}

enum ProgrammeGradingScaleAuditActionType {
  Created
  GradeRowsUpdated
  Approved
  Superseded
}

enum CloRowStatus {
  Active
  Inactive
}

enum AssessmentItemMode {
  Individual
  Group
}

enum AssessmentItemStatus {
  Active
  Inactive
}

enum MappingComponentKind {
  Week
  Assessment
}

enum QaCycleStatus {
  Draft
  Active
  UnderReview
  Closed
}

enum QaEvidenceKind {
  SystemLink
  ExternalLink
  Document
}

enum QaEvidenceStatus {
  Draft
  Ready
  Reviewed
}

enum QaEvidenceAnalysisState {
  EvidenceIdentified
  PotentialEvidenceGap
  ExpertReviewRequired
}

enum QaAnalysisReviewDecision {
  Confirmed
  Rejected
  NeedsMoreEvidence
}

enum QaSarSectionStatus {
  NotStarted
  Drafting
  ReadyForReview
  UnderReview
  ChangesRequested
  Approved
}

enum QaSarReviewDecision {
  Approved
  ChangesRequested
  MoreEvidenceRequested
}

enum UserHonorific {
  Mr
  Ms
  Mrs
  Mx
  Dr
  Prof
}

model User {
  id            String         @id @default(uuid())
  authId        String?        @unique
  email         String         @unique
  name          String
  honorific     UserHonorific?
  title         String?
  qualification String?
  phone         String?
  createdAt     DateTime       @default(now())

  coursesLed                       Course[]                            @relation("CourseLecturer")
  offeringsLed                     Offering[]                          @relation("OfferingLecturer")
  rubricsOwned                     Rubric[]                            @relation("RubricOwner")
  coLecturerOf                     OfferingCoLecturer[]                @relation("OfferingCoLecturer")
  roleAssignments                  UserRoleAssignment[]
  courseSpecSubmissions            CourseSpec[]                        @relation("CourseSpecSubmittedBy")
  courseSpecReviewActions          CourseSpecReviewAction[]            @relation("CourseSpecReviewActor")
  courseSpecRevisionRequests       CourseSpecRevisionRequest[]         @relation("CourseSpecRevisionRequestedBy")
  curriculumVersionsCreated        ProgrammeCurriculumVersion[]        @relation("ProgrammeCurriculumVersionCreatedBy")
  curriculumAuditActions           ProgrammeCurriculumAuditAction[]    @relation("ProgrammeCurriculumAuditActor")
  gradingScaleVersionsCreated      ProgrammeGradingScaleVersion[]      @relation("ProgrammeGradingScaleVersionCreatedBy")
  gradingScaleVersionsApproved     ProgrammeGradingScaleVersion[]      @relation("ProgrammeGradingScaleVersionApprovedBy")
  gradingScaleAuditActions         ProgrammeGradingScaleAuditAction[]  @relation("ProgrammeGradingScaleAuditActor")
  studentProfile                   Student?
  lecturerProfile                  LecturerProfile?
  announcementsAuthored            CourseAnnouncement[]                @relation("AnnouncementAuthor")
  assessmentResultsPublished       AssessmentResult[]                  @relation("AssessmentResultPublishedBy")
  assessmentResultsFinalized       AssessmentResult[]                  @relation("AssessmentResultFinalizedBy")
  assessmentResultCorrections      AssessmentResultCorrection[]        @relation("AssessmentResultCorrectionActor")
  classResponsibilitiesAssigned    ClassResponsibilityAssignment[]     @relation("ClassResponsibilityAssignedBy")
  classResponsibilitiesRevoked     ClassResponsibilityAssignment[]     @relation("ClassResponsibilityRevokedBy")
  classResponsibilityAuditEvents   ClassResponsibilityAuditEvent[]     @relation("ClassResponsibilityAuditActor")
  qaCyclesCreated                  QaAssessmentCycle[]                  @relation("QaCycleCreator")
  qaEvidenceCreated                QaEvidence[]                         @relation("QaEvidenceCreator")
  qaEvidenceMappings               QaEvidenceMapping[]                  @relation("QaEvidenceMapper")
  qaAssessmentsReviewed            QaRequirementAssessment[]            @relation("QaAssessmentReviewer")
  qaAnalysisReviews                QaEvidenceAnalysisReview[]           @relation("QaAnalysisReviewer")
  qaRequirementAssignments         QaRequirementAssignment[]            @relation("QaRequirementAssignee")
  qaAssignmentsCreated             QaRequirementAssignment[]            @relation("QaRequirementAssignedBy")
  qaSarSectionsUpdated             QaSarSection[]                       @relation("QaSarSectionUpdatedBy")
  qaSarSubmissions                 QaSarSubmission[]                    @relation("QaSarSubmittedBy")
  qaSarReviews                     QaSarReview[]                        @relation("QaSarReviewer")
  qaSarReleasesFinalized           QaSarRelease[]                       @relation("QaSarReleaseFinalizedBy")
  qaEvaluationGoldReviews          QaEvaluationScenario[]               @relation("QaEvaluationGoldReviewer")
  qaEvaluationRatings              QaEvaluationHumanRating[]            @relation("QaEvaluationHumanReviewer")
}

model LecturerProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender                String?
  employmentType        String?
  fieldOfSpecialization String?
  yearsOfExperience     Int?
  legacyCoursesTaught   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]
}

model Programme {
  id        String   @id
  code      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleAssignments          UserRoleAssignment[]
  courses                  Course[]
  curricula                ProgrammeCurriculum[]
  gradingScales            ProgrammeGradingScale[]
  qaCycles                 QaAssessmentCycle[]
  qaEvidence               QaEvidence[]
  qaEvidenceMappings       QaEvidenceMapping[]
  qaAssessments            QaRequirementAssessment[]
  qaAnalyses               QaEvidenceAnalysis[]
  qaDocuments              QaDocument[]
  qaAnalysisReviews        QaEvidenceAnalysisReview[]
  qaRequirementAssignments QaRequirementAssignment[]
  qaSarSections            QaSarSection[]
  qaSarSubmissions         QaSarSubmission[]
  qaSarReleases            QaSarRelease[]
  studentCohorts           StudentCohort[]
  qaCloAttainmentSnapshots QaCloAttainmentSnapshot[]
  outcomeIndicators        ProgrammeOutcomeIndicator[]
}

model ProgrammeCurriculum {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions ProgrammeCurriculumVersion[]

  @@unique([programmeId, code])
  @@index([programmeId])
}

model ProgrammeCurriculumVersion {
  id               String                               @id @default(uuid())
  curriculumId     String
  curriculum       ProgrammeCurriculum                  @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  versionMajor     Int                                  @default(1)
  versionMinor     Int                                  @default(0)
  status           ProgrammeCurriculumStatus            @default(Draft)
  revisionType     ProgrammeCurriculumRevisionType      @default(Initial)
  revisionTriggers ProgrammeCurriculumRevisionTrigger[] @default([])
  revisionReason   String                               @default("")
  changeSummary    String                               @default("")
  basedOnVersionId String?
  basedOnVersion   ProgrammeCurriculumVersion?          @relation("ProgrammeCurriculumVersionHistory", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions  ProgrammeCurriculumVersion[]         @relation("ProgrammeCurriculumVersionHistory")
  cohortLabel      String                               @default("")
  intakeYear       Int?
  academicYear     String                               @default("")
  effectiveFrom    DateTime?                            @db.Date
  approvedAt       DateTime?
  createdById      String
  createdBy        User                                 @relation("ProgrammeCurriculumVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt

  courses      ProgrammeCurriculumCourse[]
  pathways     ProgrammeCurriculumPathway[]
  auditActions ProgrammeCurriculumAuditAction[]

  @@unique([curriculumId, versionMajor, versionMinor])
  @@index([curriculumId, status])
  @@index([basedOnVersionId])
  @@index([createdById])
}

model ProgrammeCurriculumPathway {
  id                  String                     @id @default(uuid())
  curriculumVersionId String
  curriculumVersion   ProgrammeCurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  code                String
  name                String
  yearLevel           Int
  semester            Semester
  isDefault           Boolean                    @default(false)
  creditTarget        Int?
  sortOrder           Int                        @default(0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @default(now())

  courses ProgrammeCurriculumCourse[]

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId, yearLevel, semester, sortOrder])
}

model ProgrammeCurriculumCourse {
  id                  String                      @id @default(uuid())
  curriculumVersionId String
  curriculumVersion   ProgrammeCurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  courseId            String
  course              Course                     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseSpecVersionId String?
  courseSpecVersion   CourseSpec?                 @relation("ProgrammeCurriculumCourseSpecVersion", fields: [courseSpecVersionId], references: [id], onDelete: Restrict)
  pathwayId           String?
  pathway             ProgrammeCurriculumPathway? @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  yearLevel           Int
  semester            Semester
  creditsSnapshot     Int
  courseTypeSnapshot  CourseType
  sortOrder           Int                        @default(0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([curriculumVersionId, courseId])
  @@index([courseId])
  @@index([courseSpecVersionId])
  @@index([pathwayId])
  @@index([curriculumVersionId, yearLevel, semester, sortOrder])
}

model ProgrammeCurriculumAuditAction {
  id                  String                             @id @default(uuid())
  curriculumVersionId String
  curriculumVersion   ProgrammeCurriculumVersion         @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  actorId             String
  actor               User                               @relation("ProgrammeCurriculumAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action              ProgrammeCurriculumAuditActionType
  note                String                             @default("")
  details             Json?
  createdAt           DateTime                           @default(now())

  @@index([curriculumVersionId, createdAt])
  @@index([actorId])
}

model ProgrammeGradingScale {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String    @default("")
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions ProgrammeGradingScaleVersion[]

  @@unique([programmeId, code])
  @@index([programmeId])
}

model ProgrammeGradingScaleVersion {
  id               String                                   @id @default(uuid())
  gradingScaleId   String
  gradingScale     ProgrammeGradingScale                     @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)
  version          Int
  status           ProgrammeGradingScaleVersionStatus        @default(Draft)
  effectiveFrom    DateTime?                                 @db.Date
  effectiveTo      DateTime?                                 @db.Date
  changeSummary    String                                    @default("")
  basedOnVersionId String?
  basedOnVersion   ProgrammeGradingScaleVersion?             @relation("ProgrammeGradingScaleVersionHistory", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions  ProgrammeGradingScaleVersion[]            @relation("ProgrammeGradingScaleVersionHistory")
  legacyImported   Boolean                                   @default(false)
  createdById      String?
  createdBy        User?                                     @relation("ProgrammeGradingScaleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById     String?
  approvedBy       User?                                     @relation("ProgrammeGradingScaleVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt       DateTime?
  supersededAt     DateTime?
  createdAt        DateTime                                  @default(now())
  updatedAt        DateTime                                  @updatedAt

  grades       ProgrammeGradingScaleGrade[]
  courseSpecs  CourseSpec[]                                  @relation("CourseSpecGradingScaleVersion")
  auditActions ProgrammeGradingScaleAuditAction[]

  @@unique([gradingScaleId, version])
  @@index([gradingScaleId, status])
  @@index([effectiveFrom, effectiveTo])
  @@index([basedOnVersionId])
  @@index([createdById])
  @@index([approvedById])
}

model ProgrammeGradingScaleGrade {
  id                    String                       @id @default(uuid())
  gradingScaleVersionId String
  gradingScaleVersion   ProgrammeGradingScaleVersion @relation(fields: [gradingScaleVersionId], references: [id], onDelete: Cascade)
  sortOrder             Int
  letterGrade           String
  gradePoint            Decimal                      @db.Decimal(4, 2)
  minScore              Decimal                      @db.Decimal(5, 2)
  maxScore              Decimal                      @db.Decimal(5, 2)
  minInclusive          Boolean                      @default(true)
  maxInclusive          Boolean                      @default(false)
  explanation           String                       @default("")
  isPassing             Boolean                      @default(true)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([gradingScaleVersionId, letterGrade])
  @@unique([gradingScaleVersionId, sortOrder])
  @@index([gradingScaleVersionId])
}

model ProgrammeGradingScaleAuditAction {
  id                    String                                @id @default(uuid())
  gradingScaleVersionId String
  gradingScaleVersion   ProgrammeGradingScaleVersion          @relation(fields: [gradingScaleVersionId], references: [id], onDelete: Restrict)
  actorId               String?
  actor                 User?                                 @relation("ProgrammeGradingScaleAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action                ProgrammeGradingScaleAuditActionType
  note                  String                                @default("")
  details               Json?
  createdAt             DateTime                              @default(now())

  @@index([gradingScaleVersionId, createdAt])
  @@index([actorId])
}

model QaFramework {
  id        String   @id
  code      String
  name      String
  version   String
  sourceUrl String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria QaCriterion[]
  cycles   QaAssessmentCycle[]

  @@unique([code, version])
}

model QaCriterion {
  id          String      @id
  frameworkId String
  framework   QaFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  code        String
  title       String
  summary     String
  order       Int

  requirements QaRequirement[]

  @@unique([frameworkId, code])
  @@unique([frameworkId, order])
}

model QaRequirement {
  id          String      @id
  criterionId String
  criterion   QaCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  code        String
  title       String
  order       Int

  evidenceMappings    QaEvidenceMapping[]
  assessments         QaRequirementAssessment[]
  expectations        QaQualityExpectation[]
  analyses            QaEvidenceAnalysis[]
  assignments         QaRequirementAssignment[]
  sarSections         QaSarSection[]
  sarSubmissions      QaSarSubmission[]
  evaluationScenarios QaEvaluationScenario[]

  @@unique([criterionId, code])
  @@unique([criterionId, order])
  @@index([code])
}

model QaQualityExpectation {
  id                      String        @id
  requirementId           String
  requirement             QaRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  statement               String
  purpose                 String        @default("")
  order                   Int
  active                  Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @default(now())
  relationshipRequirement Json          @default("{\"requiredLinks\":[]}")

  expectedEvidence    QaExpectedEvidence[]
  analyses            QaEvidenceAnalysis[]
  evidenceMappings    QaEvidenceMapping[]
  evaluationScenarios QaEvaluationScenario[]

  @@unique([requirementId, order])
  @@index([requirementId, active])
}

model QaExpectedEvidence {
  id            String               @id
  expectationId String
  expectation   QaQualityExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)
  evidenceType  String
  description   String
  role          String
  sourceDomain  String
  order         Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now())

  @@unique([expectationId, order])
  @@index([sourceDomain])
}

model QaAssessmentCycle {
  id             String        @id @default(uuid())
  programmeId    String
  programme      Programme     @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  frameworkId    String
  framework      QaFramework   @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  title          String
  reportingStart DateTime
  reportingEnd   DateTime
  status         QaCycleStatus @default(Draft)
  createdById    String?
  createdBy      User?         @relation("QaCycleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  evidenceMappings QaEvidenceMapping[]
  assessments      QaRequirementAssessment[]
  analyses         QaEvidenceAnalysis[]
  assignments      QaRequirementAssignment[]
  sarSections      QaSarSection[]
  sarSubmissions   QaSarSubmission[]
  sarReleases      QaSarRelease[]

  @@index([programmeId, status])
  @@index([frameworkId])
}

model QaRequirementAssignment {
  id            String            @id @default(uuid())
  programmeId   String
  programme     Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId       String
  cycle         QaAssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   QaRequirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  assigneeId    String
  assignee      User              @relation("QaRequirementAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedById  String
  assignedBy    User              @relation("QaRequirementAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([cycleId, requirementId])
  @@index([programmeId, cycleId])
  @@index([cycleId, assigneeId])
  @@index([assignedById])
}

model QaSarSection {
  id                   String             @id @default(uuid())
  programmeId          String
  programme            Programme          @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId              String
  cycle                 QaAssessmentCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          QaRequirement      @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  content              Json
  plainText            String             @default("")
  status               QaSarSectionStatus @default(NotStarted)
  practiceDescribed    Boolean            @default(false)
  resultsAnalysed      Boolean            @default(false)
  improvementExplained Boolean            @default(false)
  updatedById          String?
  updatedBy            User?              @relation("QaSarSectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  submissions QaSarSubmission[]

  @@unique([cycleId, requirementId])
  @@index([programmeId, cycleId])
  @@index([status])
  @@index([updatedById])
}

model QaSarSubmission {
  id                   String            @id @default(uuid())
  programmeId          String
  programme            Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId              String
  cycle                 QaAssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          QaRequirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  sectionId            String
  section              QaSarSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  version              Int
  content              Json
  plainText            String
  practiceDescribed    Boolean
  resultsAnalysed      Boolean
  improvementExplained Boolean
  evidenceIds          String[]
  submittedById        String
  submittedBy          User              @relation("QaSarSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt          DateTime          @default(now())

  reviews QaSarReview[]

  @@unique([sectionId, version])
  @@index([programmeId, cycleId])
  @@index([requirementId])
  @@index([submittedById])
}

model QaSarReview {
  id           String              @id @default(uuid())
  submissionId String
  submission   QaSarSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User                @relation("QaSarReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision     QaSarReviewDecision
  comment      String              @default("")
  createdAt    DateTime            @default(now())

  @@index([submissionId, createdAt])
  @@index([reviewerId])
}

model QaSarRelease {
  id              String            @id @default(uuid())
  programmeId     String
  programme       Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId         String
  cycle           QaAssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  templateVersion String            @default("aun-qa-sar-v1")
  snapshot        Json
  submissionIds   String[]
  finalizedById   String
  finalizedBy     User              @relation("QaSarReleaseFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  finalizedAt     DateTime          @default(now())

  @@unique([cycleId, version])
  @@index([programmeId, cycleId])
  @@index([finalizedById])
}

model QaEvidence {
  id              String           @id @default(uuid())
  programmeId     String
  programme       Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  title           String
  description     String           @default("")
  kind            QaEvidenceKind
  sourceUrl       String?
  sourceRef       String           @default("")
  reportingPeriod String           @default("")
  status          QaEvidenceStatus @default(Draft)
  createdById     String?
  createdBy       User?            @relation("QaEvidenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  mappings        QaEvidenceMapping[]
  analysisSources QaEvidenceAnalysisSource[]

  @@index([programmeId])
  @@index([status])
}

model QaEvidenceMapping {
  id            String                @id @default(uuid())
  programmeId   String
  programme     Programme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId       String
  cycle         QaAssessmentCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evidenceId    String
  evidence      QaEvidence            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   QaRequirement         @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  expectationId String?
  expectation   QaQualityExpectation? @relation(fields: [expectationId], references: [id], onDelete: SetNull)
  relevanceNote String                 @default("")
  mappedById    String?
  mappedBy      User?                  @relation("QaEvidenceMapper", fields: [mappedById], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([cycleId, evidenceId, requirementId])
  @@index([programmeId, cycleId])
  @@index([requirementId])
