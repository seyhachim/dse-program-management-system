}

enum StudentPortfolioArtifactKind {
  Repository
  Demo
  Report
  Presentation
  Dataset
  Other
}

enum StudentPortfolioProfessionalProvider {
  GitHub
  GitLab
  LinkedIn
  Kaggle
  HuggingFace
  Website
  ORCID
  GoogleScholar
  ResearchGate
  CodingPractice
  BIProfile
  CV
  Other
}

enum StudentPortfolioSupervisorStatus {
  Pending
  Approved
  Revoked
}

enum StudentPortfolioVerificationState {
  Unverified
  Verified
  NeedsChanges
  Revoked
