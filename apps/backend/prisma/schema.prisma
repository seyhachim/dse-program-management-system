generator client {
  provider      = "prisma-client-js"
  // Debian 12 (oven/bun image) ships OpenSSL 3.0; pin the engine so Prisma
  // doesn't misdetect and fall back to the incompatible 1.1.x binary.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  Active
  Inactive
  Pending
}

/// User.role's storage type. Named UserRole (not Role) so it doesn't collide with
/// the Role model below — the normalized role/permission tables are additive for
/// now (see Role/Permission/RolePermission doc comment); User.role still reads
/// this enum directly. See https://github.com/thymadona/dse-program-management-system/issues/65.
enum UserRole {
  admin
  lecturer
  student
}

enum OfferingStatus {
  Planned
  Active
  Completed
}

/// Syllabus §12 "Course Availability" — which semester the course is delivered in.
enum Semester {
  First
  Second
}

/// Syllabus §11 "Course Type".
enum CourseType {
  Basic
  Core
  Elective
  Specialization
  MoeysHeip
}

/// Rubric Library publication state. Active = usable, Draft = work-in-progress,
/// Archived = hidden from the default library view.
enum RubricStatus {
  Active
  Draft
  Archived
}

/// Minimal user table for local dev auth. Replaced/augmented by Supabase Auth later.
/// Lecturers are Users with role = lecturer, surfaced via the Lecturers plugin.
/// title/qualification/phone feed the syllabus "Course Details" instructor block.
model User {
  id            String   @id @default(uuid())
  authId        String?  @unique
  email         String   @unique
  name          String
  // Expand/contract (issue #67): `role` is the enum column, still present but no
  // longer read by app code — `roleId`/`roleRef` is the new source of truth. Kept
  // around (not dropped) so a mid-deploy state can't break either version of the
  // code; dropping it is a separate follow-up once this has run in production.
  role          UserRole @default(student)
  roleId        String
  roleRef       Role     @relation(fields: [roleId], references: [id])
  title         String?
  qualification String?
  phone         String?
  createdAt     DateTime @default(now())

  coursesLed      Course[]             @relation("CourseLecturer")
  offeringsLed    Offering[]           @relation("OfferingLecturer")
  rubricsOwned    Rubric[]             @relation("RubricOwner")
  coLecturerOf    OfferingCoLecturer[] @relation("OfferingCoLecturer")
  roleAssignments UserRoleAssignment[]
}

/// Normalized role/permission model (issue #65). Phase 1 (#66) added these tables
/// additively; phase 2 (#67) wires `User.roleId` to `Role` and switches
/// `requirePermission` to read `RolePermission` instead of the hardcoded
/// ROLE_PERMISSIONS map. `slug` values match UserRole's values / the permission
/// strings requirePermission() already checks (e.g. "courses:write").
model Role {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]
}

model Permission {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

/// Join table: which permissions a role grants. Composite PK prevents duplicate
/// grants; both FKs cascade so deleting a role or permission cleans up its grants.
model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Additive many-to-many bridge for User<->Role (issue #77, phase A). Named
/// `UserRoleAssignment` rather than `UserRole` because that name is already the
/// legacy enum on `User.role`. Backfilled from `User.roleId` on creation, kept
/// in sync by seed.ts — but not yet read by any app code: `User.roleId`/`roleRef`
/// remains the sole enforcement path until phase B switches `requirePermission`
/// over and phase C drops `role`/`roleId`.
model UserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Students plugin domain model.
model Student {
  id        String        @id @default(uuid())
  name      String
  email     String        @unique
  studentId String        @unique
  status    StudentStatus @default(Active)
  createdAt DateTime      @default(now())

  enrollments Enrollment[]

  @@index([status])
}

/// Courses plugin domain model. lecturerId references a User with role = lecturer
/// (validated at the service layer through registry.get('lecturers')).
model Course {
  id            String      @id @default(uuid())
  code          String      @unique
  title         String
  description   String?
  lecturerId    String?
  lecturer      User?       @relation("CourseLecturer", fields: [lecturerId], references: [id], onDelete: SetNull)
  // Syllabus Course Information — §4 credits, §5 prerequisites (free text), §11 type.
  credits       Int?
  prerequisites String?
  courseType    CourseType?
  // Admin-entered total Student Learning Time for the course (hours). Independent of
  // §16 — always a direct input, never derived. Used as the §15 Focus % denominator.
  totalSltHours Int?
  createdAt     DateTime    @default(now())

  offerings Offering[]
  spec      CourseSpec?
}

/// Course Specification wizard — the full RUPP syllabus (Part 2 §1–25) captured as a
/// single JSON document per course. `data` holds each section's content keyed by
/// section id; `status` tracks per-section draft/complete so a lecturer can save one
/// section and continue later. Overlapping §1–13 scalars are mirrored onto Course.
model CourseSpec {
  id        String   @id @default(uuid())
  courseId  String   @unique
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  status    Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Course Offerings plugin — a course delivered in a given term, with an assigned
/// lecturer, a seat capacity, and enrolled students. The architectural proof point:
/// it links Students <-> Courses <-> Lecturers through the registry.
model Offering {
  id             String         @id @default(uuid())
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturerId     String?
  lecturer       User?          @relation("OfferingLecturer", fields: [lecturerId], references: [id], onDelete: SetNull)
  term           String
  capacity       Int            @default(30)
  status         OfferingStatus @default(Planned)
  // Syllabus §12 Course Availability — optional, filled on the course spec form.
  semester       Semester?
  programmeYear  Int?
  // Syllabus §10 Other Course Lecturer(s) — optional free text, varies per term.
  otherLecturers String?
  createdAt      DateTime       @default(now())

  enrollments Enrollment[]
  coLecturers OfferingCoLecturer[]

  @@unique([courseId, term])
  @@index([status])
}

/// Join table (issue #79, supersedes #73's Course-level table): co-lecturers are
/// existing lecturer Users assigned to an Offering (a course delivered in a given
/// term) alongside its primary `Offering.lecturerId`, distinct from
/// `Offering.otherLecturers` (per-term free text, untouched by this table).
/// Cascades on either side since a row here is a pure link with no data of its
/// own to preserve.
model OfferingCoLecturer {
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  lecturerId String
  lecturer   User     @relation("OfferingCoLecturer", fields: [lecturerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([offeringId, lecturerId])
  @@index([lecturerId])
}

/// Join model linking a Student to an Offering (enrollment).
model Enrollment {
  id         String   @id @default(uuid())
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([offeringId, studentId])
}

/// §15 teaching-method vocabulary. Global and shared across all courses; grows
/// as lecturers add methods from the course-spec form. Names are unique so an
/// add of an existing name reuses the row.
model TeachingMethod {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

/// §15 assessment-method vocabulary. Same lifecycle as TeachingMethod.
model AssessmentMethod {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

/// Rubric Library — a reusable assessment grid shared across courses. `levels`
/// holds the ordered rating scale (columns) and `criteria` the rows, each with
/// one descriptor per level; both are opaque JSON validated by the shared Zod
/// schema at the API boundary. `ownerId` is the User who created it (nulled if
/// that user is removed, matching Course/Offering lecturer relations).
model Rubric {
  id          String       @id @default(uuid())
  name        String
  type        String
  description String       @default("")
  levels      Json         @default("[]")
  criteria    Json         @default("[]")
  status      RubricStatus @default(Draft)
  ownerId     String?
  owner       User?        @relation("RubricOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}
