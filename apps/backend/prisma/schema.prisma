model User {
  id            String         @id @default(uuid())
  authId        String?        @unique
  email         String         @unique
  name          String
  honorific     UserHonorific?
  title         String?
  qualification String?
  phone         String?
  createdAt          DateTime @default(now())
  mustChangePassword Boolean  @default(false)

  coursesLed                         Course[]                                  @relation("CourseLecturer")
  offeringsLed                       Offering[]                                @relation("OfferingLecturer")
  rubricsOwned                       Rubric[]                                  @relation("RubricOwner")
  coLecturerOf                       OfferingCoLecturer[]                      @relation("OfferingCoLecturer")
  roleAssignments                    UserRoleAssignment[]
  courseSpecSubmissions              CourseSpec[]                              @relation("CourseSpecSubmittedBy")
  courseSpecReviewActions            CourseSpecReviewAction[]                  @relation("CourseSpecReviewActor")
  courseSpecRevisionRequests         CourseSpecRevisionRequest[]               @relation("CourseSpecRevisionRequestedBy")
  curriculumVersionsCreated          ProgrammeCurriculumVersion[]              @relation("ProgrammeCurriculumVersionCreatedBy")
  curriculumAuditActions             ProgrammeCurriculumAuditAction[]          @relation("ProgrammeCurriculumAuditActor")
  gradingScaleVersionsCreated        ProgrammeGradingScaleVersion[]            @relation("ProgrammeGradingScaleVersionCreatedBy")
  gradingScaleVersionsApproved       ProgrammeGradingScaleVersion[]            @relation("ProgrammeGradingScaleVersionApprovedBy")
  gradingScaleAuditActions           ProgrammeGradingScaleAuditAction[]        @relation("ProgrammeGradingScaleAuditActor")
  studentProfile                     Student?
  lecturerProfile                    LecturerProfile?
  portfolioVerificationEvents        StudentPortfolioVerificationEvent[]       @relation("StudentPortfolioVerifier")
  portfolioSupervisorAssignments     StudentPortfolioSupervisorRelationship[]  @relation("PortfolioSupervisorUser")
  portfolioSupervisorApprovals       StudentPortfolioSupervisorRelationship[]  @relation("PortfolioSupervisorApprovedBy")
  portfolioSupervisorRevocations     StudentPortfolioSupervisorRelationship[]  @relation("PortfolioSupervisorRevokedBy")
  announcementsAuthored              CourseAnnouncement[]                      @relation("AnnouncementAuthor")
  assessmentResultsPublished         AssessmentResult[]                        @relation("AssessmentResultPublishedBy")
  assessmentResultsFinalized         AssessmentResult[]                        @relation("AssessmentResultFinalizedBy")
  assessmentResultCorrections        AssessmentResultCorrection[]              @relation("AssessmentResultCorrectionActor")
  assessmentGroupsCreated            AssessmentGroup[]                         @relation("AssessmentGroupCreatedBy")
  assessmentGroupScoresRecorded      AssessmentGroupScore[]                    @relation("AssessmentGroupScoreActor")
  assessmentIndividualScoresRecorded AssessmentIndividualComponent[]           @relation("AssessmentIndividualComponentActor")
  assessmentGroupAuditEvents         AssessmentGroupAuditEvent[]               @relation("AssessmentGroupAuditActor")
  assessmentGroupScoreCorrections    AssessmentGroupScoreCorrection[]          @relation("AssessmentGroupScoreCorrectionActor")
  assessmentIndividualCorrections    AssessmentIndividualComponentCorrection[] @relation("AssessmentIndividualComponentCorrectionActor")
  classResponsibilitiesAssigned      ClassResponsibilityAssignment[]           @relation("ClassResponsibilityAssignedBy")
  classResponsibilitiesRevoked       ClassResponsibilityAssignment[]           @relation("ClassResponsibilityRevokedBy")
  classResponsibilityAuditEvents     ClassResponsibilityAuditEvent[]           @relation("ClassResponsibilityAuditActor")
  qaCyclesCreated                    QaAssessmentCycle[]                       @relation("QaCycleCreator")
  qaEvidenceCreated                  QaEvidence[]                              @relation("QaEvidenceCreator")
  qaEvidenceMappings                 QaEvidenceMapping[]                       @relation("QaEvidenceMapper")
  qaAssessmentsReviewed              QaRequirementAssessment[]                 @relation("QaAssessmentReviewer")
  qaAnalysisReviews                  QaEvidenceAnalysisReview[]                @relation("QaAnalysisReviewer")
  qaRequirementAssignments           QaRequirementAssignment[]                 @relation("QaRequirementAssignee")
  qaAssignmentsCreated               QaRequirementAssignment[]                 @relation("QaRequirementAssignedBy")
  qaSarSectionsUpdated               QaSarSection[]                            @relation("QaSarSectionUpdatedBy")
  qaSarSubmissions                   QaSarSubmission[]                         @relation("QaSarSubmittedBy")
  qaSarReviews                       QaSarReview[]                             @relation("QaSarReviewer")
  qaSarReleasesFinalized             QaSarRelease[]                            @relation("QaSarReleaseFinalizedBy")
  qaEvaluationGoldReviews            QaEvaluationScenario[]                    @relation("QaEvaluationGoldReviewer")
  qaEvaluationRatings                QaEvaluationHumanRating[]                 @relation("QaEvaluationHumanReviewer")
  academicCalendarsCreated           AcademicCalendar[]                        @relation("AcademicCalendarCreatedBy")
  academicCalendarsPublished         AcademicCalendar[]                        @relation("AcademicCalendarPublishedBy")
  academicCalendarAuditActions       AcademicCalendarAuditAction[]             @relation("AcademicCalendarAuditActor")
  resourceResponsibilities           ResourceResponsibilityAssignment[]        @relation("ResourceResponsibilityUser")
  resourceResponsibilitiesAssigned   ResourceResponsibilityAssignment[]        @relation("ResourceResponsibilityAssignedBy")
  resourceResponsibilityAuditEvents  ResourceResponsibilityAuditEvent[]        @relation("ResourceResponsibilityAuditActor")
  securityAuditEventsAsActor         UserSecurityAuditEvent[]                  @relation("UserSecurityAuditActor")
  securityAuditEventsAsTarget        UserSecurityAuditEvent[]                  @relation("UserSecurityAuditTarget")
}

model LecturerProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender                String?
  employmentType        String?
  fieldOfSpecialization String?
  yearsOfExperience     Int?
  legacyCoursesTaught   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]
}

model Programme {
  id        String   @id
  code      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleAssignments                 UserRoleAssignment[]
  courses                         Course[]
  curricula                       ProgrammeCurriculum[]
  gradingScales                   ProgrammeGradingScale[]
  qaCycles                        QaAssessmentCycle[]
  qaEvidence                      QaEvidence[]
  qaEvidenceMappings              QaEvidenceMapping[]
  qaAssessments                   QaRequirementAssessment[]
  qaAnalyses                      QaEvidenceAnalysis[]
  qaDocuments                     QaDocument[]
  qaAnalysisReviews               QaEvidenceAnalysisReview[]
  qaRequirementAssignments        QaRequirementAssignment[]
  qaSarSections                   QaSarSection[]
  qaSarSubmissions                QaSarSubmission[]
  qaSarReleases                   QaSarRelease[]
  studentCohorts                  StudentCohort[]
  qaCloAttainmentSnapshots        QaCloAttainmentSnapshot[]
  outcomeIndicators               ProgrammeOutcomeIndicator[]
  publicFaqs                      ProgrammeFaq[]
  publicImportantDates            ProgrammeImportantDate[]
  publicProfile                   ProgrammePublicProfile?
  academicYears                   AcademicYear[]
  resourceTypes                   ResourceType[]
  resourceLocations               ResourceLocation[]
  resourceResponsibilities        ResourceResponsibilityAssignment[]
  resourceResponsibilityAuditEvents ResourceResponsibilityAuditEvent[]
}

model AcademicYear {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  label       String
  startYear   Int
  endYear     Int
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  calendars AcademicCalendar[]

  @@unique([programmeId, label])
  @@unique([programmeId, startYear, endYear])
  @@index([programmeId, isCurrent])
}

model AcademicCalendar {
  id                   String                 @id @default(uuid())
  academicYearId       String
  academicYear         AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  seriesKey            String
  revision             Int                    @default(1)
  status               AcademicCalendarStatus @default(Draft)
  sourceTitle          String                 @default("")
  sourcePublishedAt    DateTime?              @db.Date
  sourceUrl            String?
  sourceFileRef        String?
  sourceNote           String                 @default("")
  revisionReason       String                 @default("")
  supersedesCalendarId String?
  supersedesCalendar   AcademicCalendar?      @relation("AcademicCalendarRevisionHistory", fields: [supersedesCalendarId], references: [id], onDelete: Restrict)
  supersededBy         AcademicCalendar[]      @relation("AcademicCalendarRevisionHistory")
  createdById          String
  createdBy            User                   @relation("AcademicCalendarCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedById        String?
  publishedBy          User?                  @relation("AcademicCalendarPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt

  studyYears   AcademicCalendarStudyYear[]
  periods      AcademicCalendarPeriod[]
  events       AcademicCalendarEvent[]
  auditActions AcademicCalendarAuditAction[]

  @@unique([academicYearId, seriesKey, revision])
  @@index([academicYearId, status])
  @@index([supersedesCalendarId])
  @@index([createdById])
  @@index([publishedById])
}

model AcademicCalendarStudyYear {
  calendarId String
  calendar   AcademicCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  studyYear  Int

  @@id([calendarId, studyYear])
  @@index([studyYear, calendarId])
}

model AcademicCalendarPeriod {
  id            String           @id @default(uuid())
  calendarId    String
  calendar      AcademicCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  semester      Semester
  teachingStart DateTime         @db.Date
  teachingEnd   DateTime         @db.Date
  examStart     DateTime?        @db.Date
  examEnd       DateTime?        @db.Date
  breakStart    DateTime?        @db.Date
  breakEnd      DateTime?        @db.Date
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  offerings Offering[]

  @@unique([calendarId, semester])
  @@index([semester, teachingStart, teachingEnd])
}

model AcademicCalendarEvent {
  id         String                    @id @default(uuid())
  calendarId String
  calendar   AcademicCalendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title      String
  type       AcademicCalendarEventType
  semester   Semester?
  startDate  DateTime                  @db.Date
  endDate    DateTime?                 @db.Date
  note       String                    @default("")
  sortOrder  Int                       @default(0)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @default(now()) @updatedAt

  @@index([calendarId, startDate, sortOrder])
}

model AcademicCalendarAuditAction {
  id             String                          @id @default(uuid())
  calendarId     String
  calendar       AcademicCalendar                @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  actorId        String
  actor          User                            @relation("AcademicCalendarAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action         AcademicCalendarAuditActionType
  reason         String                          @default("")
  beforeSnapshot Json?
  afterSnapshot  Json?
  details        Json?
  createdAt      DateTime                        @default(now())

  @@index([calendarId, createdAt])
  @@index([actorId])
}

/// Programme-managed logical locations for inventory. These do not replace or
/// schedule OfferingMeeting.room; a future canonical facilities model can be
/// integrated explicitly without making inventory own the timetable.
model ResourceLocation {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  responsibilityAssignments ResourceResponsibilityAssignment[]

  @@unique([programmeId, code])
  @@unique([programmeId, name])
  @@index([programmeId, active])
}

/// Canonical programme resource catalogue. Holdings/serialized assets are
/// intentionally introduced by #752; this row only defines what the resource is.
model ResourceType {
  id           String               @id @default(uuid())
  programmeId  String
  programme    Programme            @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  name         String
  category     String
  description  String               @default("")
  unit         String
  trackingMode ResourceTrackingMode
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt

  @@unique([programmeId, name])
  @@index([programmeId, active])
  @@index([programmeId, category])
}

/// Effective-dated operational responsibility. It is separate from Role because
/// it is transferable programme work, not a permanent account type/global role.
model ResourceResponsibilityAssignment {
  id             String                     @id @default(uuid())
  programmeId    String
  programme      Programme                  @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  userId         String
  user           User                       @relation("ResourceResponsibilityUser", fields: [userId], references: [id], onDelete: Restrict)
  responsibility ResourceResponsibilityType
  locationId     String?
  location       ResourceLocation?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime                   @db.Date
  effectiveTo    DateTime?                  @db.Date
  assignedById   String
  assignedBy     User                       @relation("ResourceResponsibilityAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  reason         String                     @default("")
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @default(now()) @updatedAt

  auditEvents ResourceResponsibilityAuditEvent[]

  @@index([programmeId, responsibility, effectiveFrom, effectiveTo])
  @@index([userId, programmeId])
  @@index([locationId])
  @@index([assignedById])
}

/// Append-only governance trail for assignment, renewal, ending and handover.
model ResourceResponsibilityAuditEvent {
  id           String                            @id @default(uuid())
  assignmentId String?
  assignment   ResourceResponsibilityAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  programmeId  String
  programme    Programme                         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  actorId      String
  actor        User                              @relation("ResourceResponsibilityAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action       ResourceResponsibilityAuditAction
  reason       String                            @default("")
  details      Json?
  createdAt    DateTime                          @default(now())

  @@index([programmeId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([actorId])
}

model ProgrammeCurriculum {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions ProgrammeCurriculumVersion[]

  @@unique([programmeId, code])
  @@index([programmeId])
}

model ProgrammeCurriculumVersion {
  id               String                               @id @default(uuid())
  curriculumId     String
  curriculum       ProgrammeCurriculum                  @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  versionMajor     Int                                  @default(1)
  versionMinor     Int                                  @default(0)
  status           ProgrammeCurriculumStatus            @default(Draft)
  revisionType     ProgrammeCurriculumRevisionType      @default(Initial)
  revisionTriggers ProgrammeCurriculumRevisionTrigger[] @default([])
  revisionReason   String                               @default("")
  changeSummary    String                               @default("")
  basedOnVersionId String?
  basedOnVersion   ProgrammeCurriculumVersion?          @relation("ProgrammeCurriculumVersionHistory", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions  ProgrammeCurriculumVersion[]         @relation("ProgrammeCurriculumVersionHistory")
  cohortLabel      String                               @default("")
  intakeYear       Int?
  academicYear     String                               @default("")
  effectiveFrom    DateTime?                            @db.Date
  approvedAt       DateTime?
  createdById      String
  createdBy        User                                 @relation("ProgrammeCurriculumVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt

  courses      ProgrammeCurriculumCourse[]
  pathways     ProgrammeCurriculumPathway[]
  auditActions ProgrammeCurriculumAuditAction[]

  @@unique([curriculumId, versionMajor, versionMinor])
  @@index([curriculumId, status])
  @@index([basedOnVersionId])
  @@index([createdById])
}

model ProgrammeCurriculumPathway {
  id                  String                     @id @default(uuid())
  curriculumVersionId String
  curriculumVersion   ProgrammeCurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  code                String
  name                String
  yearLevel           Int
  semester            Semester
  isDefault           Boolean                    @default(false)
  creditTarget        Int?
  sortOrder           Int                        @default(0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @default(now())

  courses ProgrammeCurriculumCourse[]

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId, yearLevel, semester, sortOrder])
}

model ProgrammeCurriculumCourse {
  id                  String                      @id @default(uuid())
  curriculumVersionId String
  curriculumVersion   ProgrammeCurriculumVersion  @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  courseId            String
  course              Course                      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseSpecVersionId String?
  courseSpecVersion   CourseSpec?                 @relation("ProgrammeCurriculumCourseSpecVersion", fields: [courseSpecVersionId], references: [id], onDelete: Restrict)
  pathwayId           String?
  pathway             ProgrammeCurriculumPathway? @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  yearLevel           Int
  semester            Semester
  creditsSnapshot     Int
  courseTypeSnapshot  CourseType
  sortOrder           Int                         @default(0)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([curriculumVersionId, courseId])
  @@index([courseId])
  @@index([courseSpecVersionId])
  @@index([pathwayId])
  @@index([curriculumVersionId, yearLevel, semester, sortOrder])
}

model ProgrammeCurriculumAuditAction {
  id                  String                             @id @default(uuid())
  curriculumVersionId String
  curriculumVersion   ProgrammeCurriculumVersion         @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  actorId             String
  actor               User                               @relation("ProgrammeCurriculumAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action              ProgrammeCurriculumAuditActionType
  note                String                             @default("")
  details             Json?
  createdAt           DateTime                           @default(now())

  @@index([curriculumVersionId, createdAt])
  @@index([actorId])
}

model ProgrammeGradingScale {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String    @default("")
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions ProgrammeGradingScaleVersion[]

  @@unique([programmeId, code])
  @@index([programmeId])
}

model ProgrammeGradingScaleVersion {
  id               String                             @id @default(uuid())
  gradingScaleId   String
  gradingScale     ProgrammeGradingScale              @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)
  version          Int
  status           ProgrammeGradingScaleVersionStatus @default(Draft)
  effectiveFrom    DateTime?                          @db.Date
  effectiveTo      DateTime?                          @db.Date
  changeSummary    String                             @default("")
  basedOnVersionId String?
  basedOnVersion   ProgrammeGradingScaleVersion?      @relation("ProgrammeGradingScaleVersionHistory", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions  ProgrammeGradingScaleVersion[]     @relation("ProgrammeGradingScaleVersionHistory")
  legacyImported   Boolean                            @default(false)
  createdById      String?
  createdBy        User?                              @relation("ProgrammeGradingScaleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById     String?
  approvedBy       User?                              @relation("ProgrammeGradingScaleVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt       DateTime?
  supersededAt     DateTime?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  grades       ProgrammeGradingScaleGrade[]
  courseSpecs  CourseSpec[]                       @relation("CourseSpecGradingScaleVersion")
  auditActions ProgrammeGradingScaleAuditAction[]

  @@unique([gradingScaleId, version])
  @@index([gradingScaleId, status])
  @@index([effectiveFrom, effectiveTo])
  @@index([basedOnVersionId])
  @@index([createdById])
  @@index([approvedById])
}

model ProgrammeGradingScaleGrade {
  id                    String                       @id @default(uuid())
  gradingScaleVersionId String
  gradingScaleVersion   ProgrammeGradingScaleVersion @relation(fields: [gradingScaleVersionId], references: [id], onDelete: Cascade)
  sortOrder             Int
  letterGrade           String
  gradePoint            Decimal                      @db.Decimal(4, 2)
  minScore              Decimal                      @db.Decimal(5, 2)
  maxScore              Decimal                      @db.Decimal(5, 2)
  minInclusive          Boolean                      @default(true)
  maxInclusive          Boolean                      @default(false)
  explanation           String                       @default("")
  isPassing             Boolean                      @default(true)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([gradingScaleVersionId, letterGrade])
  @@unique([gradingScaleVersionId, sortOrder])
  @@index([gradingScaleVersionId])
}

model ProgrammeGradingScaleAuditAction {
  id                    String                               @id @default(uuid())
  gradingScaleVersionId String
  gradingScaleVersion   ProgrammeGradingScaleVersion         @relation(fields: [gradingScaleVersionId], references: [id], onDelete: Restrict)
  actorId               String?
  actor                 User?                                @relation("ProgrammeGradingScaleAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action                ProgrammeGradingScaleAuditActionType
  note                  String                               @default("")
  details               Json?
  createdAt             DateTime                             @default(now())

  @@index([gradingScaleVersionId, createdAt])
  @@index([actorId])
}

model QaFramework {
  id        String   @id
  code      String
  name      String
  version   String
  sourceUrl String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria QaCriterion[]
  cycles   QaAssessmentCycle[]

  @@unique([code, version])
}

model QaCriterion {
  id          String      @id
  frameworkId String
  framework   QaFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  code        String
  title       String
  summary     String
  order       Int

  requirements QaRequirement[]

  @@unique([frameworkId, code])
  @@unique([frameworkId, order])
}

model QaRequirement {
  id          String      @id
  criterionId String
  criterion   QaCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  code        String
  title       String
  order       Int

  evidenceMappings    QaEvidenceMapping[]
  assessments         QaRequirementAssessment[]
  expectations        QaQualityExpectation[]
  analyses            QaEvidenceAnalysis[]
  assignments         QaRequirementAssignment[]
  sarSections         QaSarSection[]
  sarSubmissions      QaSarSubmission[]
  evaluationScenarios QaEvaluationScenario[]

  @@unique([criterionId, code])
  @@unique([criterionId, order])
  @@index([code])
}

model QaQualityExpectation {
  id                      String        @id
  requirementId           String
  requirement             QaRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  statement               String
  purpose                 String        @default("")
  order                   Int
  active                  Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @default(now())
  relationshipRequirement Json          @default("{\"requiredLinks\":[]}")

  expectedEvidence    QaExpectedEvidence[]
  analyses            QaEvidenceAnalysis[]
  evidenceMappings    QaEvidenceMapping[]
  evaluationScenarios QaEvaluationScenario[]

  @@unique([requirementId, order])
  @@index([requirementId, active])
}

model QaExpectedEvidence {
  id            String               @id
  expectationId String
  expectation   QaQualityExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)
  evidenceType  String
  description   String
  role          String
  sourceDomain  String
  order         Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now())

  @@unique([expectationId, order])
  @@index([sourceDomain])
}

model QaAssessmentCycle {
  id             String        @id @default(uuid())
  programmeId    String
  programme      Programme     @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  frameworkId    String
  framework      QaFramework   @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  title          String
  reportingStart DateTime
  reportingEnd   DateTime
  status         QaCycleStatus @default(Draft)
  createdById    String?
  createdBy      User?         @relation("QaCycleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  evidenceMappings QaEvidenceMapping[]
  assessments      QaRequirementAssessment[]
  analyses         QaEvidenceAnalysis[]
  assignments      QaRequirementAssignment[]
  sarSections      QaSarSection[]
  sarSubmissions   QaSarSubmission[]
  sarReleases      QaSarRelease[]

  @@index([programmeId, status])
  @@index([frameworkId])
}

model QaRequirementAssignment {
  id            String            @id @default(uuid())
  programmeId   String
  programme     Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId       String
  cycle         QaAssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   QaRequirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  assigneeId    String
  assignee      User              @relation("QaRequirementAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedById  String
  assignedBy    User              @relation("QaRequirementAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([cycleId, requirementId])
  @@index([programmeId, cycleId])
  @@index([cycleId, assigneeId])
  @@index([assignedById])
}

model QaSarSection {
  id                   String             @id @default(uuid())
  programmeId          String
  programme            Programme          @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId              String
  cycle                QaAssessmentCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          QaRequirement      @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  content              Json
  plainText            String             @default("")
  status               QaSarSectionStatus @default(NotStarted)
  practiceDescribed    Boolean            @default(false)
  resultsAnalysed      Boolean            @default(false)
  improvementExplained Boolean            @default(false)
  updatedById          String?
  updatedBy            User?              @relation("QaSarSectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  submissions QaSarSubmission[]

  @@unique([cycleId, requirementId])
  @@index([programmeId, cycleId])
  @@index([status])
  @@index([updatedById])
}

model QaSarSubmission {
  id                   String            @id @default(uuid())
  programmeId          String
  programme            Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId              String
  cycle                QaAssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          QaRequirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  sectionId            String
  section              QaSarSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  version              Int
  content              Json
  plainText            String
  practiceDescribed    Boolean
  resultsAnalysed      Boolean
  improvementExplained Boolean
  evidenceIds          String[]
  submittedById        String
  submittedBy          User              @relation("QaSarSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt          DateTime          @default(now())

  reviews QaSarReview[]

  @@unique([sectionId, version])
  @@index([programmeId, cycleId])
  @@index([requirementId])
  @@index([submittedById])
}

model QaSarReview {
  id           String              @id @default(uuid())
  submissionId String
  submission   QaSarSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User                @relation("QaSarReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision     QaSarReviewDecision
  comment      String              @default("")
  createdAt    DateTime            @default(now())

  @@index([submissionId, createdAt])
  @@index([reviewerId])
}

model QaSarRelease {
  id              String            @id @default(uuid())
  programmeId     String
  programme       Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId         String
  cycle           QaAssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  templateVersion String            @default("aun-qa-sar-v1")
  snapshot        Json
  submissionIds   String[]
  finalizedById   String
  finalizedBy     User              @relation("QaSarReleaseFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  finalizedAt     DateTime          @default(now())

  @@unique([cycleId, version])
  @@index([programmeId, cycleId])
  @@index([finalizedById])
}

model QaEvidence {
  id              String           @id @default(uuid())
  programmeId     String
  programme       Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  title           String
  description     String           @default("")
  kind            QaEvidenceKind
  sourceUrl       String?
  sourceRef       String           @default("")
  reportingPeriod String           @default("")
  status          QaEvidenceStatus @default(Draft)
  createdById     String?
  createdBy       User?            @relation("QaEvidenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  mappings        QaEvidenceMapping[]
  analysisSources QaEvidenceAnalysisSource[]

  @@index([programmeId])
  @@index([status])
}

model QaEvidenceMapping {
  id            String                @id @default(uuid())
  programmeId   String
  programme     Programme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId       String
  cycle         QaAssessmentCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evidenceId    String
  evidence      QaEvidence            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   QaRequirement         @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  expectationId String?
  expectation   QaQualityExpectation? @relation(fields: [expectationId], references: [id], onDelete: SetNull)
  relevanceNote String                @default("")
  mappedById    String?
  mappedBy      User?                 @relation("QaEvidenceMapper", fields: [mappedById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([cycleId, evidenceId, requirementId])
  @@index([programmeId, cycleId])
  @@index([requirementId])
  @@index([evidenceId])
  @@index([expectationId])
  @@index([mappedById])
}

model QaRequirementAssessment {
  programmeId   String
  programme     Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId       String
  cycle         QaAssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   QaRequirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  rating        Int?
  narrative     String            @default("")
  reviewerId    String?
  reviewer      User?             @relation("QaAssessmentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@id([cycleId, requirementId])
  @@index([programmeId, cycleId])
  @@index([reviewerId])
}

model QaEvidenceAnalysis {
  id              String                     @id @default(uuid())
  programmeId     String
  programme       Programme                  @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cycleId         String
  cycle           QaAssessmentCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requirementId   String
  requirement     QaRequirement              @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  expectationId   String
  expectation     QaQualityExpectation       @relation(fields: [expectationId], references: [id], onDelete: Restrict)
  state           QaEvidenceAnalysisState
  explanation     String                     @default("")
  confidence      Float?
  uncertaintyNote String                     @default("")
  engine          String
  engineVersion   String
  promptVersion   String                     @default("")
  createdAt       DateTime                   @default(now())
  sources         QaEvidenceAnalysisSource[]
  reviews         QaEvidenceAnalysisReview[]

  @@index([programmeId, cycleId, createdAt])
  @@index([requirementId, createdAt])
  @@index([expectationId, createdAt])
  @@index([engine, promptVersion])
}

model QaEvidenceAnalysisReview {
  id          String                   @id @default(uuid())
  programmeId String
  programme   Programme                @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  analysisId  String
  analysis    QaEvidenceAnalysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User                     @relation("QaAnalysisReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision    QaAnalysisReviewDecision
  comment     String                   @default("")
  createdAt   DateTime                 @default(now())

  @@index([programmeId, createdAt])
  @@index([analysisId, createdAt])
  @@index([reviewerId])
}

model QaEvidenceAnalysisSource {
  id            String             @id @default(uuid())
  analysisId    String
  analysis      QaEvidenceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  sourceKind    String
  candidateKey  String
  sourceDomain  String
  entityType    String
  entityId      String
  qaEvidenceId  String?
  qaEvidence    QaEvidence?        @relation(fields: [qaEvidenceId], references: [id], onDelete: SetNull)
  title         String
  summary       String             @default("")
  excerpt       String             @default("")
  route         String?
  reportingDate DateTime?
  relevance     Float?
  createdAt     DateTime           @default(now())

  @@unique([analysisId, candidateKey])
  @@index([qaEvidenceId])
  @@index([entityType, entityId])
}

model QaDocument {
  id             String            @id @default(uuid())
  programmeId    String
  programme      Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  title          String
  documentType   String
  sourceUrl      String?
  sourceRef      String            @default("")
  version        String            @default("1")
  reportingStart DateTime?
  reportingEnd   DateTime?
  contentHash    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  chunks         QaDocumentChunk[]

  @@index([programmeId, documentType])
  @@index([programmeId, reportingEnd])
}

model QaDocumentChunk {
  id             String     @id
  documentId     String
  document       QaDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  pageNumber     Int?
  sectionLabel   String     @default("")
  startOffset    Int
  endOffset      Int
  text           String
  embedding      Float[]    @default([])
  embeddingModel String     @default("")
  createdAt      DateTime   @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([embeddingModel])
}

model QaEvaluationScenario {
  id              String                         @id @default(uuid())
  requirementId   String
  requirement     QaRequirement                  @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  expectationId   String
  expectation     QaQualityExpectation           @relation(fields: [expectationId], references: [id], onDelete: Restrict)
  name            String
  description     String
  goldState       QaEvidenceAnalysisState?
  goldReviewerId  String?
  goldReviewer    User?                          @relation("QaEvaluationGoldReviewer", fields: [goldReviewerId], references: [id], onDelete: SetNull)
  goldAnnotatedAt DateTime?
  goldNote        String                         @default("")
  evidence        QaEvaluationScenarioEvidence[]
  runs            QaEvaluationRun[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([requirementId])
  @@index([expectationId])
  @@index([goldState])
}

model QaEvaluationScenarioEvidence {
  id            String                    @id @default(uuid())
  scenarioId    String
  scenario      QaEvaluationScenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  order         Int
  evidenceType  String                    @default("")
  sourceDomain  String
  entityType    String
  label         String
  text          String
  referenceKey  String                    @default("")
  reportingDate DateTime?
  attributes    Json                      @default("{}")
  goldRelevant  Boolean?
  runLinks      QaEvaluationRunEvidence[]

  @@unique([scenarioId, order])
  @@index([scenarioId, goldRelevant])
  @@index([scenarioId, evidenceType])
}

model QaEvaluationRun {
  id             String                    @id @default(uuid())
  scenarioId     String
  scenario       QaEvaluationScenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  predictedState QaEvidenceAnalysisState
  engine         String
  engineVersion  String
  promptVersion  String                    @default("")
  explanation    String
  createdAt      DateTime                  @default(now())
  retrieved      QaEvaluationRunEvidence[]
  humanRatings   QaEvaluationHumanRating[]

  @@index([scenarioId, createdAt])
  @@index([engine, engineVersion, promptVersion])
}

model QaEvaluationRunEvidence {
  runId              String
  run                QaEvaluationRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioEvidenceId String
  scenarioEvidence   QaEvaluationScenarioEvidence @relation(fields: [scenarioEvidenceId], references: [id], onDelete: Cascade)
  relevance          Float?

  @@id([runId, scenarioEvidenceId])
  @@index([scenarioEvidenceId])
}

model QaEvaluationHumanRating {
  id                 String          @id @default(uuid())
  runId              String
  run                QaEvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           User            @relation("QaEvaluationHumanReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  evidenceRelevance  Int
  explanationClarity Int
  understandability  Int
  usefulness         Int
  traceability       Int
  comment            String          @default("")
  createdAt          DateTime        @default(now())

  @@unique([runId, reviewerId])
  @@index([reviewerId])
}

model Permission {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  userId      String
  roleId      String
  programmeId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  programme Programme? @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([programmeId])
}

model Student {
  id                               String                                   @id @default(uuid())
  name                             String
  email                            String?                                  @unique
  studentId                        String                                   @unique
  status                           StudentStatus                            @default(Active)
  createdAt                        DateTime                                 @default(now())
  userId                           String?                                  @unique
  user                             User?                                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile                          StudentProfile?
  portfolioProfile                 StudentPortfolioProfile?
  portfolioEvidence                StudentPortfolioEvidence[]
  portfolioProfessionalLinks       StudentPortfolioProfessionalLink[]
  portfolioSupervisorRelationships StudentPortfolioSupervisorRelationship[]

  enrollments                    Enrollment[]
  classResponsibilityAssignments ClassResponsibilityAssignment[]
  classResponsibilityAuditEvents ClassResponsibilityAuditEvent[]
  cohortMemberships              StudentCohortMembership[]

  @@index([status])
}

model StudentProfile {
  id              String   @id @default(uuid())
  studentRecordId String   @unique
  student         Student  @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
  khmerFamilyName String?
  khmerGivenName  String?
  latinFamilyName String?
  latinGivenName  String?
  gender          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([gender])
}

model StudentPortfolioProfile {
  id              String   @id @default(uuid())
  studentId       String   @unique
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  headline        String   @default("")
  bio             String   @default("")
  careerInterests String[] @default([])
  isPublic        Boolean  @default(false)
  publicSlug      String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublic])
}

model StudentPortfolioEvidence {
  id                     String                              @id @default(uuid())
  studentId              String
  student                Student                             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  origin                 StudentPortfolioEvidenceOrigin
  title                  String
  summary                String                              @default("")
  role                   String                              @default("")
  contribution           String                              @default("")
  startDate              DateTime?                           @db.Date
  endDate                DateTime?                           @db.Date
  skills                 String[]                            @default([])
  isPublic               Boolean                             @default(false)
  isFeatured             Boolean                             @default(false)
  sourceType             StudentPortfolioEvidenceSourceType?
  sourceOfferingId       String?
  sourceOffering         Offering?                           @relation(fields: [sourceOfferingId], references: [id], onDelete: Restrict)
  sourceCourseSpecId     String?
  sourceAssessmentItemId String?
  sourceAssessmentItem   CourseSpecAssessmentItem?           @relation(fields: [sourceCourseSpecId, sourceAssessmentItemId], references: [courseSpecId, id], onDelete: Restrict)
  sourceLinkedAt         DateTime?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  archivedAt             DateTime?
  links                  StudentPortfolioEvidenceLink[]
  verificationEvents     StudentPortfolioVerificationEvent[]
  softSkills             StudentPortfolioEvidenceSoftSkill[]

  @@index([studentId, updatedAt])
  @@index([studentId, isPublic, isFeatured])
  @@index([sourceOfferingId])
  @@index([sourceCourseSpecId, sourceAssessmentItemId])
}

model StudentPortfolioEvidenceLink {
  id         String                       @id @default(uuid())
  evidenceId String
  evidence   StudentPortfolioEvidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
