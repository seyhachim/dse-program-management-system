  revokedBy   User?                           @relation("ClassResponsibilityRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  auditEvents ClassResponsibilityAuditEvent[]

  @@index([offeringId])
  @@index([studentId, offeringId])
  @@index([offeringId, role])
  @@index([offeringId, revokedAt])
  @@index([assignedById])
  @@index([revokedById])
}

model ClassResponsibilityAuditEvent {
  id           String                         @id @default(uuid())
  assignmentId String?
  offeringId   String
  studentId    String
  actorId      String
  action       ClassResponsibilityAuditAction
  previousRole ClassResponsibilityRole?
  newRole      ClassResponsibilityRole?
  reason       String                         @default("")
  details      Json?
  createdAt    DateTime                       @default(now())

  assignment ClassResponsibilityAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  offering   Offering                       @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  student    Student                        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actor      User                           @relation("ClassResponsibilityAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([offeringId, createdAt])
  @@index([studentId])
  @@index([actorId])
  @@index([assignmentId])
}

model OfferingAssessmentDeadline {
  id               String   @id @default(uuid())
  offeringId       String
  offering         Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  courseSpecId     String
  assessmentItemId String
  dueAt            DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([offeringId, courseSpecId, assessmentItemId])
  @@index([offeringId, dueAt])
}

model AssessmentResult {
  id               String                       @id @default(uuid())
  enrollmentId     String
  enrollment       Enrollment                   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  courseSpecId     String
  assessmentItemId String
  score            Float
  maxScore         Float
  feedback         String                       @default("")
  publishedAt      DateTime?
  publishedById    String?
  publishedBy      User?                        @relation("AssessmentResultPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  finalizedAt      DateTime?
  finalizedById    String?
  finalizedBy      User?                        @relation("AssessmentResultFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  criterionScores  AssessmentCriterionScore[]
  corrections      AssessmentResultCorrection[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([enrollmentId, courseSpecId, assessmentItemId])
  @@index([enrollmentId, publishedAt])
  @@index([publishedById])
  @@index([finalizedAt])
  @@index([finalizedById])
}

model AssessmentResultCorrection {
  id                 String           @id @default(uuid())
  assessmentResultId String
  assessmentResult   AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Restrict)
  beforeScore        Float
  beforeMaxScore     Float
  beforeFeedback     String
  afterScore         Float
  afterMaxScore      Float
  afterFeedback      String
  reason             String
  correctedById      String
  correctedBy        User             @relation("AssessmentResultCorrectionActor", fields: [correctedById], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([assessmentResultId, createdAt])
  @@index([correctedById])
}

model AssessmentCriterionScore {
  id                 String           @id @default(uuid())
  assessmentResultId String
  assessmentResult   AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)
  rubricId           String
  criterionId        String
  criterionName      String
  rubricContentHash  String
  score              Float
  maxScore           Float
  rubricLevelId      String?
  rubricLevelLabel   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([assessmentResultId, rubricId, criterionId])
  @@index([assessmentResultId])
  @@index([rubricId, criterionId])
}

model AssessmentGroup {
  id                 String                   @id @default(uuid())
  offeringId         String
  offering           Offering                 @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  courseSpecId       String
  assessmentItemId   String
  assessmentItem     CourseSpecAssessmentItem @relation(fields: [courseSpecId, assessmentItemId], references: [courseSpecId, id], onDelete: Restrict)
  name               String
  sortOrder          Int                      @default(0)
  membershipLockedAt DateTime?
  publishedAt        DateTime?
  finalizedAt        DateTime?
  createdById        String
  createdBy          User                     @relation("AssessmentGroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  members              AssessmentGroupMember[]
  score                AssessmentGroupScore?
  individualComponents AssessmentIndividualComponent[]

  @@unique([id, offeringId, courseSpecId, assessmentItemId])
  @@unique([offeringId, courseSpecId, assessmentItemId, name])
  @@index([offeringId, assessmentItemId, sortOrder])
  @@index([createdById])
}

model AssessmentGroupMember {
  id                  String          @id @default(uuid())
  groupId             String
  offeringId          String
  courseSpecId        String
  assessmentItemId    String
  group               AssessmentGroup @relation(fields: [groupId, offeringId, courseSpecId, assessmentItemId], references: [id, offeringId, courseSpecId, assessmentItemId], onDelete: Cascade)
  enrollmentId        String
  enrollment          Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  studentIdSnapshot   String
  studentCodeSnapshot String
  studentNameSnapshot String
  createdAt           DateTime        @default(now())

  @@unique([offeringId, courseSpecId, assessmentItemId, enrollmentId])
  @@index([groupId])
  @@index([enrollmentId])
}

model AssessmentGroupScore {
  id                String                           @id @default(uuid())
  groupId           String                           @unique
  group             AssessmentGroup                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  score             Float
  maxScore          Float
  feedback          String                           @default("")
  rubricId          String?
  rubricContentHash String?
  scoredById        String
  scoredBy          User                             @relation("AssessmentGroupScoreActor", fields: [scoredById], references: [id], onDelete: Restrict)
  criterionScores   AssessmentGroupCriterionScore[]
  corrections       AssessmentGroupScoreCorrection[]
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  @@index([scoredById])
}

model AssessmentGroupCriterionScore {
  id                String               @id @default(uuid())
  groupScoreId      String
  groupScore        AssessmentGroupScore @relation(fields: [groupScoreId], references: [id], onDelete: Cascade)
  rubricId          String
  criterionId       String
  criterionName     String
  rubricContentHash String
  score             Float
  maxScore          Float
  rubricLevelId     String?
  rubricLevelLabel  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([groupScoreId, rubricId, criterionId])
  @@index([rubricId, criterionId])
}

model AssessmentIndividualComponent {
  id               String                                    @id @default(uuid())
  groupId          String
  offeringId       String
  courseSpecId     String
  assessmentItemId String
  group            AssessmentGroup                           @relation(fields: [groupId, offeringId, courseSpecId, assessmentItemId], references: [id, offeringId, courseSpecId, assessmentItemId], onDelete: Cascade)
  enrollmentId     String
  enrollment       Enrollment                                @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  score            Float
  maxScore         Float
  feedback         String                                    @default("")
  adjustmentPoints Float                                     @default(0)
  adjustmentReason String                                    @default("")
  scoredById       String
  scoredBy         User                                      @relation("AssessmentIndividualComponentActor", fields: [scoredById], references: [id], onDelete: Restrict)
  criterionScores  AssessmentIndividualCriterionScore[]
  corrections      AssessmentIndividualComponentCorrection[]
  createdAt        DateTime                                  @default(now())
  updatedAt        DateTime                                  @updatedAt

  @@unique([enrollmentId, courseSpecId, assessmentItemId])
  @@index([groupId])
  @@index([scoredById])
}

model AssessmentIndividualCriterionScore {
  id                String                        @id @default(uuid())
  componentId       String
  component         AssessmentIndividualComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  rubricId          String
  criterionId       String
  criterionName     String
  rubricContentHash String
  score             Float
  maxScore          Float
  rubricLevelId     String?
  rubricLevelLabel  String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([componentId, rubricId, criterionId])
  @@index([rubricId, criterionId])
}

model AssessmentGroupScoreCorrection {
  id             String               @id @default(uuid())
  groupScoreId   String
  groupScore     AssessmentGroupScore @relation(fields: [groupScoreId], references: [id], onDelete: Restrict)
  beforeScore    Float
  beforeMaxScore Float
  beforeFeedback String
  afterScore     Float
  afterMaxScore  Float
  afterFeedback  String
  reason         String
  correctedById  String
  correctedBy    User                 @relation("AssessmentGroupScoreCorrectionActor", fields: [correctedById], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())

  @@index([groupScoreId, createdAt])
  @@index([correctedById])
}

model AssessmentIndividualComponentCorrection {
  id                     String                        @id @default(uuid())
  componentId            String
  component              AssessmentIndividualComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  beforeScore            Float
  beforeMaxScore         Float
  beforeFeedback         String
  beforeAdjustmentPoints Float
  beforeAdjustmentReason String
  afterScore             Float
  afterMaxScore          Float
  afterFeedback          String
  afterAdjustmentPoints  Float
  afterAdjustmentReason  String
  reason                 String
  correctedById          String
  correctedBy            User                          @relation("AssessmentIndividualComponentCorrectionActor", fields: [correctedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                      @default(now())

  @@index([componentId, createdAt])
  @@index([correctedById])
}

model AssessmentGroupAuditEvent {
  id               String                     @id @default(uuid())
  offeringId       String
  courseSpecId     String
  assessmentItemId String
  groupId          String?
  enrollmentId     String?
  action           AssessmentGroupAuditAction
  actorId          String
  actor            User                       @relation("AssessmentGroupAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason           String                     @default("")
  details          Json?
  createdAt        DateTime                   @default(now())

  @@index([offeringId, assessmentItemId, createdAt])
  @@index([groupId, createdAt])
  @@index([enrollmentId, createdAt])
  @@index([actorId])
}

model CourseAnnouncement {
  id          String    @id @default(uuid())
  offeringId  String
  offering    Offering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title       String
  body        String
  pinned      Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([offeringId, publishedAt])
}

model CourseFeedback {
  id                      String   @id @default(uuid())
  offeringId              String
  offering                Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  responseKeyHash         String
  overallRating           Int
  teachingClarityRating   Int
  assessmentClarityRating Int
  workload                String
  positiveComment         String   @default("")
  improvementComment      String   @default("")
  createdAt               DateTime @default(now())

  @@unique([offeringId, responseKeyHash])
  @@index([offeringId, createdAt])
}

model TeachingMethod {
  id        String                        @id @default(uuid())
  name      String                        @unique
  active    Boolean                       @default(true)
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt
  cloLinks  CourseSpecCloTeachingMethod[]
}

model AssessmentMethod {
  id        String                          @id @default(uuid())
  name      String                          @unique
  active    Boolean                         @default(true)
  createdAt DateTime                        @default(now())
  updatedAt DateTime                        @updatedAt
  cloLinks  CourseSpecCloAssessmentMethod[]
}

model ActiveLearningCluster {
  id          String                   @id
  name        String
  description String                   @default("")
  sortOrder   Int                      @default(0)
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  strategies  ActiveLearningStrategy[]

  @@index([active, sortOrder])
}

model ActiveLearningStrategy {
  id        String                @id
  name      String
  clusterId String
  cluster   ActiveLearningCluster @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  sortOrder Int                   @default(0)
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([clusterId, active, sortOrder])
}

model Rubric {
  id              String                     @id @default(uuid())
  name            String
  type            String
  description     String                     @default("")
  status          RubricStatus               @default(Draft)
  ownerId         String?
  owner           User?                      @relation("RubricOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  levelRows       RubricLevel[]
  criterionRows   RubricCriterion[]
  assessmentItems CourseSpecAssessmentItem[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status])
  @@index([ownerId])
}

model RubricLevel {
  id       String       @id @default(uuid())
  rubricId String
  rubric   Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  label    String
  points   Float
  order    Int
  cells    RubricCell[]

  @@index([rubricId])
}

model RubricCriterion {
  id       String
  rubricId String
  rubric   Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name     String
  order    Int
  cells    RubricCell[]

  @@id([rubricId, id])
  @@index([name])
}

model RubricCell {
  rubricId    String
  criterionId String
  criterion   RubricCriterion @relation(fields: [rubricId, criterionId], references: [rubricId, id], onDelete: Cascade)
  levelId     String
  level       RubricLevel     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  descriptor  String

  @@id([rubricId, criterionId, levelId])
  @@index([levelId])
}

model ProgrammeFaq {
  id            String                           @id @default(uuid())
  programmeId   String
  programme     Programme                        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  category      ProgrammeFaqCategory
  slug          String                           @unique
  question      String
  answer        String
  shortAnswer   String?
  keywords      String[]                         @default([])
  questionKm    String?
  answerKm      String?
  shortAnswerKm String?
  keywordsKm    String[]                         @default([])
  sortOrder     Int                              @default(0)
  isFeatured    Boolean                          @default(false)
  status        ProgrammePublicPublicationStatus @default(Draft)
  sourceLabel   String?
  sourceUrl     String?
  publishedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt

  @@index([programmeId, category, status, sortOrder])
  @@index([programmeId, status, isFeatured])
}

model ProgrammeImportantDate {
  id            String                           @id @default(uuid())
  programmeId   String
  programme     Programme                        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  kind          ProgrammeImportantDateKind
  title         String
  description   String                           @default("")
  titleKm       String?
  descriptionKm String?
  date          DateTime                         @db.Date
  endDate       DateTime?                        @db.Date
  sortOrder     Int                              @default(0)
  status        ProgrammePublicPublicationStatus @default(Draft)
  publishedAt   DateTime?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt

  @@index([programmeId, status, date])
  @@index([programmeId, kind, status])
}

model ProgrammePublicProfile {
  id              String    @id @default(uuid())
  programmeId     String    @unique
  programme       Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  programmeName   String
  shortName       String
  overview        String    @default("")
  programmeNameKm String?
  shortNameKm     String?
  overviewKm      String?
  admissionEmail  String?
  phone           String?
  websiteUrl      String?
  facebookUrl     String?
  campusAddress   String?
  campusAddressKm String?
  mapUrl          String?
  applicationUrl  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model UserSecurityAuditEvent {
  id           String                  @id @default(uuid()) @db.Uuid
  action       UserSecurityAuditAction
  actorUserId  String
  actor        User                    @relation("UserSecurityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId String
  target       User                    @relation("UserSecurityAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  createdAt    DateTime                @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}
