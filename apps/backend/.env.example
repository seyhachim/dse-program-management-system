# Copy to apps/backend/.env and fill in.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/dsepms?schema=public"

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Performance observability (optional) ---
# API responses always expose privacy-safe Server-Timing. The settings below
# only enable normalized slow-request / summary logs; they never log bodies,
# auth headers, query values, or raw record identifiers.
# PERF_SLOW_REQUEST_MS=300
# PERF_SUMMARY_EVERY=100
# PERF_SUMMARY_TOP=10
# PERF_SUMMARY_MAX_ROUTES=100
# Benchmark helpers (use temporary local/shell env values; never commit tokens):
# PERF_BASE_URL=http://localhost:4000
# PERF_BENCH_RUNS=10
# PERF_BENCH_WARMUPS=1
# PERF_DB_PING_RUNS=10
# PERF_DB_PING_WARMUPS=1

# --- Auth ---
# AUTH_MODE is required and never defaults.
# Use `dev` only for local development/tests.
# Production must use `supabase` and will fail startup otherwise.
AUTH_MODE=dev

# local/test dev mode only: secret used to sign/verify local development tokens.
# Do not configure or rely on this as production authentication.
JWT_SECRET=change-me-to-a-long-random-string

# supabase mode ---------------------------------------------------------------
# Required whenever AUTH_MODE=supabase. Production requires an HTTPS endpoint.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Admin API base + service_role key (SERVER-ONLY secret) for inviting accounts.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Where invite/set-password links land (your frontend callback route).
SUPABASE_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Telegram: authenticated DSE PMS Bot ---
# Disabled by default so the normal PMS does not require Telegram credentials.
TELEGRAM_PMS_ENABLED=false
# SERVER-ONLY BotFather token for the authenticated PMS/Mini App bot.
# Never expose this through NEXT_PUBLIC_*.
TELEGRAM_PMS_BOT_TOKEN=
# PMS bot username without the leading @.
TELEGRAM_PMS_BOT_USERNAME=
# URL Telegram opens for the Mini App. Use HTTPS outside local development.
TELEGRAM_MINI_APP_URL=http://localhost:3000/telegram
# BotFather Mini App short name on the PMS bot.
TELEGRAM_MINI_APP_SHORT_NAME=pms
# Reject otherwise-valid Telegram initData older than this many seconds.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
# Tolerate only this much positive server/client clock skew.
TELEGRAM_INIT_DATA_MAX_FUTURE_SKEW_SECONDS=30

# Existing deployments may temporarily keep TELEGRAM_ENABLED,
# TELEGRAM_BOT_TOKEN and TELEGRAM_BOT_USERNAME as PMS-only aliases while
# migrating. New deployments should use the TELEGRAM_PMS_* names above.

# --- Telegram: public DSE Information Bot ---
# This is a separate BotFather bot. It never authenticates PMS Mini App users.
TELEGRAM_PUBLIC_ENABLED=false
# SERVER-ONLY BotFather token for public programme information / Ask DSE.
TELEGRAM_PUBLIC_BOT_TOKEN=
# Public information bot username without the leading @.
TELEGRAM_PUBLIC_BOT_USERNAME=
# Strong secret registered with Telegram for /api/telegram/public/webhook.
TELEGRAM_PUBLIC_WEBHOOK_SECRET=
# Programme whose published public information this bot renders.
TELEGRAM_PUBLIC_PROGRAMME_ID=dse

# When both Telegram bots are enabled they MUST use different bot tokens.
