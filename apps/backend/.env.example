# Copy to apps/backend/.env and fill in.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/dsepms?schema=public"

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# AUTH_MODE is required and never defaults.
# Use `dev` only for local development/tests.
# Production must use `supabase` and will fail startup otherwise.
AUTH_MODE=dev

# local/test dev mode only: secret used to sign/verify local development tokens.
# Do not configure or rely on this as production authentication.
JWT_SECRET=change-me-to-a-long-random-string

# supabase mode ---------------------------------------------------------------
# Required whenever AUTH_MODE=supabase. Production requires an HTTPS endpoint.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Admin API base + service_role key (SERVER-ONLY secret) for inviting accounts.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Where invite/set-password links land (your frontend callback route).
SUPABASE_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback
