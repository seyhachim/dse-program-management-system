# ── Backend ────────────────────────────────────────────────────────────────
# PostgreSQL connection used by Prisma.
# Point this at your local PostgreSQL instance or a hosted PostgreSQL database
# such as Supabase. Docker is not required for normal local development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Authentication mode: "dev" for local JWTs or "supabase" for per-user login.
AUTH_MODE="dev"

# Required in dev auth mode. Use a strong secret outside local development.
JWT_SECRET="dev-only-change-me-super-secret"

# Backend HTTP port
PORT=4000

# Comma-separated allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:3000"

# Supabase Auth backend settings. Required only when AUTH_MODE="supabase".
SUPABASE_JWKS_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_INVITE_REDIRECT_URL="http://localhost:3000/auth/callback"

# Optional QA semantic-retrieval embeddings. The endpoint must accept an
# OpenAI-compatible `{ model, input }` embeddings request and return `data[].embedding`.
# If these are blank, QA documents are still stored/chunked but semantic retrieval
# remains explicitly unavailable and cannot count as evidence coverage.
QA_EMBEDDING_API_URL=""
QA_EMBEDDING_API_KEY=""
QA_EMBEDDING_MODEL=""

# Optional QA evidence-matching LLM. The endpoint must accept an OpenAI-compatible
# chat-completions request and return JSON in `choices[0].message.content`.
# If URL/model are blank, LLM-assisted analysis is explicitly unavailable; the
# deterministic evidence analysis remains usable and no fallback result is fabricated.
QA_LLM_API_URL=""
QA_LLM_API_KEY=""
QA_LLM_MODEL=""

# ── Frontend ───────────────────────────────────────────────────────────────
# Base URL of the backend API
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Frontend authentication mode. Keep aligned with AUTH_MODE.
NEXT_PUBLIC_AUTH_MODE="dev"

# Dev-only bearer token minted with `bun run gen-token --role admin`.
# Ignored when NEXT_PUBLIC_AUTH_MODE="supabase".
NEXT_PUBLIC_DEV_TOKEN=""

# Supabase browser settings. Required only in Supabase auth mode.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
