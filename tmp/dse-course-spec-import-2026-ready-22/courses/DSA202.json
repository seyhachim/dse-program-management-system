  "lessonPlan": {
    "topics": [
      {
        "number": 1,
        "title": "Topic 1: Review of the Python Programming Language",
        "clos": [
          "CLO1",
          "CLO3"
        ],
        "llosRaw": "LLO1: Apply core Python syntax, data types, control structures, and functions for basic engineering problems."
      },
      {
        "number": 2,
        "title": "Topic 2: Introduction to Non-Linear DSA",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO2: Identify real-world problems where non-linear data structures provide efficient solutions"
      },
      {
        "number": 3,
        "title": "Topic 3: Hash Table",
        "clos": [
          "CLO1",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO3: Implement a hash table in a programming language with appropriate collision handling"
      },
      {
        "number": 4,
        "title": "Topic 4: Binary Tree",
        "clos": [
          "CLO1",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO4: Explain different types of binary trees (full, complete, perfect) and implement traversal algorithms (in-order, pre-order, post-order) using a programming language"
      },
      {
        "number": 5,
        "title": "Topic 5: Binary Search Tree",
        "clos": [
          "CLO1",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO5: explain the properties of binary search trees, implement insertion, deletion, and traversal algorithms"
      },
      {
        "number": 6,
        "title": "Topic 6: AVL Tree",
        "clos": [
          "CLO1",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO6: explain AVL tree properties, perform rotations, and implement insertion and deletion to maintain balanced tree structures"
      },
      {
        "number": 7,
        "title": "Topic 7: Graph–directed graph",
        "clos": [
          "CLO1",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO7: define directed graphs, represent them using adjacency structures, and implement traversal algorithms such as DFS and BFS"
      },
      {
        "number": 8,
        "title": "Topic 8: Graph–undirected graph/weighted",
        "clos": [
          "CLO1",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO8: represent undirected and weighted graphs, analyse edge properties, and implement traversal algorithms for efficient problem-solving applications"
      },
      {
        "number": 9,
        "title": "Topic 9: Shortest path Algorism",
        "clos": [
          "CLO1",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO9: understand shortest path algorithms, compare approaches, and implement Dijkstra’s method to solve mapping optimization problems"
      },
      {
        "number": 10,
        "title": "Topic 10: Project-Based – Hashing Table",
        "clos": [
          "CLO2",
          "CLO3",
          "CLO4"
        ],
        "llosRaw": "LLO10: Develop and implement hashing tables to manage data efficiently, handle collisions, and optimize search and insertion in real-world applications"
      },
      {
        "number": 11,
        "title": "Topic 11: Project-Based – Tree Project",
        "clos": [],
        "llosRaw": "LLO11: Design, implement, and analyse tree-based data structures to efficiently organize, traverse, and manipulate hierarchical data in practical projects"
      },
      {
        "number": 12,
        "title": "Topic 12: Project-Based – Graph Project",
        "clos": [],
        "llosRaw": "LLO12: Design, implement, and analyse graph-based data structures to model relationships, optimize traversal, and solve real-world network problems efficiently"
      },
      {
        "number": 13,
        "title": "Topic 13: Project-Based Learning - Project Presentation",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO13: Design, implement, and evaluate projects using non-linear data structures, applying problem-solving, optimization, and analysis to real-world scenarios effectively"
      },
      {
        "number": 14,
        "title": "Topic 14: Project-Based Learning - Project Presentation",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO14: Effectively present and communicate project results on non-linear data structures, demonstrating understanding, analysis, implementation, and problem-solving skills clearly"
      },
      {
        "number": 15,
        "title": "",
        "clos": [],
        "llosRaw": ""
      }
    ],
