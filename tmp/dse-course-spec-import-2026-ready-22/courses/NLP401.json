  "course": {
    "programmeTitle": "Bachelor of Engineering in Data Science and Engineering",
    "code": "NLP401",
    "title": "Natural Language Processing (NLP)",
    "credits": {
      "total": 3.0
    },
    "prerequisites": null,
    "courseType": "Core",
    "availability": {
      "semester": 1,
      "year": 4
    },
    "description": "This course provides a comprehensive introduction to the field of Natural Language Processing, bridging foundational linguistic concepts with modern deep learning techniques. Students begin by exploring the core principles of text preprocessing, tokenization, and language modeling, before advancing to hands-on implementation of key algorithms such as word embeddings, sequence models, and transformers. The curriculum covers essential applications, including sentiment analysis, text classification, machine translation, and question answering, with a strong focus on leveraging state-of-the-art frameworks like PyTorch and Hugging Face. Students will also gain practical experience in building and fine-tuning NLP models, deploying them for real-world tasks, and addressing challenges such as bias, scalability, and low-resource language processing. Finally, the course emphasizes ethical AI practices and equips students with the skills to evaluate, interpret, and improve NLP systems for reliable and responsible deployment."
  },
