  "lessonPlan": {
    "topics": [
      {
        "number": 1,
        "title": "Topic 1: Introduction to NLP",
        "clos": [
          "CLO1",
          "CLO4"
        ],
        "llosRaw": "Explain the scope, challenges, and applications of NLP in real-world contexts (Understand)."
      },
      {
        "number": 2,
        "title": "Topic 2: Text Processing & Regular Expressions",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Apply tokenization, stemming, and lemmatization techniques for text preprocessing (Apply)."
      },
      {
        "number": 3,
        "title": "Topic 3: Language Modeling & Probability Basics",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Explain the concept of n-gram models and smoothing techniques (Understand)."
      },
      {
        "number": 4,
        "title": "Topic 4: Word Representations",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Compare sparse and dense text representations such as BoW, TF-IDF, and embeddings (Analyse)."
      },
      {
        "number": 5,
        "title": "Topic 5: Neural Networks for NLP",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Describe the structure of basic neural networks for text classification (Understand)."
      },
      {
        "number": 6,
        "title": "Topic 6: Sequence Models – RNNs & LSTMs",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Analyse the strengths and limitations of RNNs, LSTMs, and GRUs (Analyse)."
      },
      {
        "number": 7,
        "title": "Topic 7: Attention Mechanism",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Explain the intuition behind sequence-to-sequence models with attention (Understand)."
      },
      {
        "number": 8,
        "title": "Topic 8: Transformers & BERT",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Describe the architecture of transformers and self-attention (Understand)."
      },
      {
        "number": 9,
        "title": "Evaluate understanding of NLP foundations from Topics 1–8 (Evaluate).",
        "clos": [
          "CLO1",
          "CLO2"
        ],
        "llosRaw": "Midterm Exam"
      },
      {
        "number": 10,
        "title": "Topic 9: Machine Translation",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Analyse the differences between statistical, rule-based, and neural MT approaches (Analyse)."
      },
      {
        "number": 11,
        "title": "Topic 10: Information Retrieval & Question Answering",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Implement basic retrieval methods such as TF-IDF and BM25 (Apply)."
      },
      {
        "number": 12,
        "title": "Topic 11: Text Classification & Sentiment Analysis",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Compare traditional ML classifiers with deep learning approaches for sentiment analysis (Analyse)."
      },
      {
        "number": 13,
        "title": "Topic 12: Dialogue Systems & Chatbots",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Differentiate between rule-based, retrieval-based, and generative chatbots (Analyse)."
      },
      {
        "number": 14,
        "title": "Topic 13: Ethics, Bias & Fairness in NLP",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Explain the sources of bias in NLP models and datasets (Understand)."
      },
      {
        "number": 15,
        "title": "Topic 14: Advanced Topics in NLP + Project Presentation",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Discuss recent advancements in multilingual NLP, low-resource learning, and LLMs (Understand)."
      }
    ],
