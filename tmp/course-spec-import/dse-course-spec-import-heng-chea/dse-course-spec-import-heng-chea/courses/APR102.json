  "lessonPlan": {
    "topics": [
      {
        "number": 1,
        "title": "Topic 1: Introduction to Python",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO1: Develop simple Python programs using variables, operators, and input/output statements. LLO2: Apply Python programming structures to solve basic computational problems."
      },
      {
        "number": 2,
        "title": "Topic 2: List",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO1: Use 1D lists to store and process data-related tasks. LLO2: Use 2D lists to store and process data-related tasks."
      },
      {
        "number": 3,
        "title": "Topic 3: Dictionary",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO1: Develop Python programs using dictionary operations and methods. LLO2: Apply dictionaries to organize and manage structured data efficiently."
      },
      {
        "number": 4,
        "title": "Topic 4: User-defined Function",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO1: Develop user-defined functions with parameters and return values. LLO2: Apply functions to create modular and reusable Python programs."
      },
      {
        "number": 5,
        "title": "Topic 5: Jupyter Notebook",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "LLO1: Utilize Jupyter Notebook to write and execute Python programs interactively. LLO2: Apply notebook tools and markdown features to document programming tasks effectively."
      },
      {
        "number": 6,
        "title": "Topic 6: NumPy",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "LLO1: Analyze datasets using NumPy arrays and mathematical operations. LLO2: Apply NumPy functions for numerical computation and data manipulation."
      },
      {
        "number": 7,
        "title": "Topic 7: Pandas",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "LLO1: Analyze datasets using Pandas DataFrames and query operations. LLO2: Apply Pandas merging techniques to combine multiple DataFrames effectively. LLO3: Analyze datasets using aggregation functions and GroupBy operations. LLO4: Apply Pandas functions to read from and write data to CSV files."
      },
      {
        "number": 8,
        "title": "Topic 8: Matplotlib",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "LLO1: Develop data visualizations using Matplotlib charting techniques. LLO2: Apply Matplotlib to present data findings effectively through graphical representations."
      },
      {
        "number": 9,
        "title": "Topic 9: Seaborn",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "LLO1: Develop statistical visualizations using Seaborn plotting functions. LLO2: Apply Seaborn to communicate data insights clearly and professionally."
      }
    ],
