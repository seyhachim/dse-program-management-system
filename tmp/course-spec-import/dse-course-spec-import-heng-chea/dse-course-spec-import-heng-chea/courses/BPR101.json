  "lessonPlan": {
    "topics": [
      {
        "number": 1,
        "title": "Topic 1: Introduction to C++",
        "clos": [
          "CLO1",
          "CLO3"
        ],
        "llosRaw": "LLO1: Apply C++ syntax to construct simple programs LLO2: Develop and execute basic C++ programs"
      },
      {
        "number": 2,
        "title": "Topic 2: Mathematical Functions",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO1: Apply mathematical functions to solve computational problems LLO2: Implement built-in functions in C++ programs"
      },
      {
        "number": 3,
        "title": "Topic 3: Selections",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO1: Apply selection structures to solve decision-making problems LLO2: Develop programs using conditional logic"
      },
      {
        "number": 4,
        "title": "Topic 4: Loops",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO 1: Implement and contrast while and for loops for condition-based execution and sequence iteration. LLO 2: Construct do-while loops for post-test conditional logic, such as input validation. LLO 3: Design and debug nested loops to process multi-dimensional data and track multi-level iterations."
      },
      {
        "number": 5,
        "title": "Topic 5: Single-dimensional Array",
        "clos": [
          "CLO2",
          "CLO3"
        ],
        "llosRaw": "LLO1: Apply arrays to store and process data LLO2: Develop programs using single-dimensional arrays"
      },
      {
        "number": 6,
        "title": "Topic 6: Jump Statements",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "LLO1: Apply jump statements to control program flow LLO2: Develop programs using break, continue, and return"
      },
      {
        "number": 7,
        "title": "Topic 7: Character & String",
        "clos": [
          "CLO2",
          "CLO3"
        ],
        "llosRaw": "LLO1: Apply string and character operations in C++ programs LLO2: Develop programs for text processing"
      },
      {
        "number": 8,
        "title": "Topic 8: Multi-dimensional Array",
        "clos": [
          "CLO2",
          "CLO3"
        ],
        "llosRaw": "LLO1: Apply multi-dimensional arrays to represent structured data LLO2: Develop programs using matrices for problem solving"
      }
    ],
