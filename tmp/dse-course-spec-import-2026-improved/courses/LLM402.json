  "lessonPlan": {
    "topics": [
      {
        "number": 1,
        "title": "Topic 1: Introduction to LLM",
        "clos": [
          "CLO1",
          "CLO4"
        ],
        "llosRaw": "Explain the scope, challenges, and applications of Large Language Models (LLMs) in real-world contexts (Understand)."
      },
      {
        "number": 2,
        "title": "Topic 2: Text Processing & Tokenization",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Apply tokenization and text preprocessing techniques used in LLM pipelines (Apply)."
      },
      {
        "number": 3,
        "title": "Topic 3: Tokenization Algorithms for LLMs",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Explain subword tokenization methods such as BPE, WordPiece, and SentencePiece (Understand)."
      },
      {
        "number": 4,
        "title": "Topic 4: Word & Contextual Embeddings",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Compare different embedding representations (static vs. contextual) used in LLMs (Analyse)."
      },
      {
        "number": 5,
        "title": "Topic 5: Neural Networks & Transformer Basics",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Describe the structure of Transformer-based models for language tasks (Understand)."
      },
      {
        "number": 6,
        "title": "Topic 6: LLM Architectures",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Analyse the strengths and limitations of decoder-only, encoder-only, and encoder–decoder LLM architectures (Analyse)."
      },
      {
        "number": 7,
        "title": "Topic 7: Attention Mechanisms in LLMs",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Explain the role of self-attention and multi-head attention in LLM inference (Understand)."
      },
      {
        "number": 8,
        "title": "Topic 8: Pretraining & Fine-Tuning LLMs",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Describe pretraining, fine-tuning, and instruction tuning processes in large language models (Understand)."
      },
      {
        "number": 9,
        "title": "Evaluate understanding of LLM concepts from Topics 1–8 (Evaluate).",
        "clos": [
          "CLO1",
          "CLO2"
        ],
        "llosRaw": "Midterm Exam"
      },
      {
        "number": 10,
        "title": "Topic 9: Machine Translation with LLMs",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Analyse the differences between statistical, neural, and LLM-based machine translation (Analyse)."
      },
      {
        "number": 11,
        "title": "Topic 10: Information Retrieval & RAG",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Implement retrieval-augmented generation (RAG) and basic retrieval pipelines (Apply)."
      },
      {
        "number": 12,
        "title": "Topic 11: Text Classification with LLMs",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Compare traditional ML vs. LLM-based approaches for sentiment and text classification (Analyse)."
      },
      {
        "number": 13,
        "title": "Topic 12: Dialogue Systems & Chatbots",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Differentiate between rule-based, retrieval-based, and LLM-powered generative chatbots (Analyse)."
      },
      {
        "number": 14,
        "title": "Topic 13: Ethics, Bias & Safety in LLMs",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Explain sources of bias, hallucination, and ethical risks in LLMs (Understand)."
      },
      {
        "number": 15,
        "title": "Topic 14: Advanced Topics + Project Presentation",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Discuss recent advancements in multilingual LLMs, low-resource learning, and frontier LLM capabilities (Understand)."
      }
    ],
