  "lessonPlan": {
    "topics": [
      {
        "number": 1,
        "title": "Topic 1: Introduction & Database Design for BI",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Define OLTP and OLAP and explain the differences in purpose and structure."
      },
      {
        "number": 2,
        "title": "Topic 2: SQL Server Essentials",
        "clos": [
          "CLO1"
        ],
        "llosRaw": "Describe SQL Server components and create basic schema objects"
      },
      {
        "number": 3,
        "title": "Topic 3: ETL Concepts & Tools",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Demonstrate how to import raw data into a staging area using SQL Server Integration Services"
      },
      {
        "number": 4,
        "title": "Topic 4: ETL Transformation",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Apply data cleaning and transformation operations"
      },
      {
        "number": 5,
        "title": "Topic 5: ETL Loading",
        "clos": [
          "CLO2"
        ],
        "llosRaw": "Implement incremental and historical loading into a data warehouse fact and dimension tables."
      },
      {
        "number": 6,
        "title": "Topic 6: SQL Queries for Analytics",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Write aggregation queries (SUM, AVG, COUNT) across fact and dimension tables."
      },
      {
        "number": 7,
        "title": "Topic 7: Advanced Query Techniques",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Apply window functions (ROW_NUMBER, RANK, LAG, LEAD) to calculate trends and rankings"
      },
      {
        "number": 8,
        "title": "Topic 8: Performance & Optimization",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Interpret query execution plans and apply indexing strategies for optimization."
      },
      {
        "number": 9,
        "title": "Topic 9: Introduction to OLAP",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Differentiate MOLAP, ROLAP, and HOLAP and explain their use cases."
      },
      {
        "number": 10,
        "title": "Topic 10: Cube Design",
        "clos": [
          "CLO3"
        ],
        "llosRaw": "Design an OLAP cube with fact measures and dimension hierarchies in SSAS."
      },
      {
        "number": 11,
        "title": "Topic 11: Advanced OLAP",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Construct MDX queries to retrieve KPI values from a cube."
      },
      {
        "number": 12,
        "title": "Topic 12: Data Visualization & BI Tools",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Build a Power BI dashboard connected to a SQL Server data warehouse."
      },
      {
        "number": 13,
        "title": "Topic 13: Data Warehouse Project",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Collaborate in teams to design and implement an end-to-end DW + BI solution."
      },
      {
        "number": 14,
        "title": "Topic 14: Review & Future Trends",
        "clos": [
          "CLO4"
        ],
        "llosRaw": "Summarize course concepts and discuss the role of cloud data warehouses in BI"
      }
    ],
