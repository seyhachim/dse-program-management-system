  "course": {
    "programmeTitle": "Bachelor of Engineering in Data Science and Engineering",
    "code": "DWA202",
    "title": "Data Warehousing",
    "credits": {
      "total": 3.0
    },
    "prerequisites": "Basic of Database",
    "courseType": "Core",
    "availability": {
      "year": 2,
      "semester": 2
    },
    "description": "This course introduces students to SQL Server as a platform for data warehousing and business intelligence. Students learn to design data warehouses, implement ETL processes using SQL Server Integration Services (SSIS), perform advanced SQL queries for analytics, build OLAP cubes with SQL Server Analysis Services (SSAS), and connect data warehouses to visualization tools (Power BI, Excel). The course emphasizes practical application through a capstone project where students design and implement a BI solution."
  },
